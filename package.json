{
  "name": "pjsip-node",
  "version": "1.0.0",
  "description": "PJSIP wrapper for Node.js - Similar to baresip-node",
  "main": "lib/index.js",
  "scripts": {
    "build": "npm run build:native",
    "build:native": "node-gyp rebuild --arch=x64",
    "test": "node test.js",
    "clean": "rimraf build",
    "prebuild": "npm run clean && node -e \"require('fs').mkdirSync('build',{recursive:true})\"",
    "configure": "node-gyp configure --arch=x64",
    "install": "npm run build",
    "start": "node test.js"
  },
  "keywords": [
    "pjsip",
    "sip",
    "voip",
    "node",
    "addon",
    "baresip",
    "native"
  ],
  "author": "Bhavdeep",
  "license": "MIT",
  "dependencies": {
    "bindings": "^1.5.0",
    "node-addon-api": "^8.5.0"
  },
  "devDependencies": {
    "rimraf": "^5.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "build/Release/",
    "README.md",
    "LICENSE",
    "binding.gyp",
    "src/",
    "pjproject-2.15.1/",
    "*.lib",
    "lib/"
  ]
}
